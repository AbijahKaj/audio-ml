{
  "name": "audio-ml",
  "version": "1.0.2",
  "description": "A comprehensive JavaScript/TypeScript library for audio feature extraction, designed for machine learning applications and voice AI systems",
  "type": "module",
  "main": "./dist/analysis/index.js",
  "types": "./dist/analysis/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/analysis/index.js",
      "types": "./dist/analysis/index.d.ts"
    },
    "./applications": {
      "import": "./dist/applications/index.js",
      "types": "./dist/applications/index.d.ts"
    },
    "./asr": {
      "import": "./dist/asr/index.js",
      "types": "./dist/asr/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:package": "tsc",
    "test": "vitest run",
    "prepublishOnly": "yarn build:package"
  },
  "keywords": [
    "audio",
    "audio-analysis",
    "feature-extraction",
    "mfcc",
    "fft",
    "spectral-analysis",
    "voice-ai",
    "speech-recognition",
    "machine-learning",
    "signal-processing",
    "dsp",
    "typescript"
  ],
  "author": "Abijah Kajabika",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbijahKaj/audio-ml.git"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "fft.js": "^4.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
